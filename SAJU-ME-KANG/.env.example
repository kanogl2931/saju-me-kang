# Gemini API 키 (https://aistudio.google.com/apikey 에서 발급)
# 실제 키는 .env 파일에 저장하세요. .env는 Git에 커밋되지 않습니다.
VITE_GEMINI_API_KEY=your_api_key_here

# Supabase (https://supabase.com/dashboard/project/khgdqmllhjvzkltbtzfw)
# Project URL / Publishable key는 Connect 패널에서 확인
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
